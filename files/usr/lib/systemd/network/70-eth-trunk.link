# Names this VM's network interface "eth-trunk" without needing a
# hand-picked/pinned MAC address anywhere. This only works because
# eth-trunk is, by design, the VM's *only* network device (see
# manifests/30-virtualmachine.yaml - no separate "default" pod network,
# no other NICs): matching on the driver alone is unambiguous precisely
# because there is nothing else it could match. If a second physical
# interface is ever added to the VM, this rule must be replaced with
# MAC-based matching again (one .link file per interface, matching on
# `MACAddress=` instead of `Driver=`), since two devices can't both be
# renamed to the same name.
[Match]
Driver=virtio_net

[Link]
Name=eth-trunk
