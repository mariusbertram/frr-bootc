[Unit]
Description=Sync FRR configuration from the mounted frr-config ConfigMap
RequiresMountsFor=/run/config/frr
Wants=network-config-sync.service
After=network-config-sync.service

[Service]
Type=simple
ExecStart=/usr/local/bin/frr-config-sync
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
