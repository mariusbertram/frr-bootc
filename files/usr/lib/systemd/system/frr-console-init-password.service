[Unit]
Description=Generate an initial root password for console login, if needed
Documentation=https://github.com/mariusbertram/frr-bootc
# Ordered before the console units so the password (and the banner
# frr-console shows for it) is ready by the very first frame they draw -
# see frr-console-init-password's own comment for why this is safe to run
# on every boot, not just a true "first boot".
Before=frr-console-tty1.service frr-console-ttyS0.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/frr-console-init-password

[Install]
WantedBy=multi-user.target
