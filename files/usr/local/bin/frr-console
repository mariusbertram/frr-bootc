#!/usr/bin/bash
# Router status dashboard - runs permanently on the console (Talos-Linux
# style), not something a login lands in. It's launched directly as the
# console handler by frr-console-tty1.service (graphical/VNC,
# virtctl vnc) and frr-console-ttyS0.service (serial, virtctl console),
# which replace getty@tty1.service/serial-getty@ttyS0.service outright
# (masked in the Containerfile) - see the comment in each of those two
# unit files for the full boot-time picture. No ANSI beyond
# "clear"/"bold"/basic 8-color setaf, which every terminal either console
# can realistically show up on supports.
#
# This exists because there is no dashboard/alerting for this VM (see the
# comment at the top of frr-config-sync) - console access is the only way
# in, so the console itself should always be showing the same "is
# everything actually working" information a human would otherwise have
# to piece together by hand from several journalctl/vtysh/ip/systemctl
# calls.
#
# Viewing the dashboard needs no authentication - whoever already has
# console access to this VM is already a privileged operator. 'b' drops
# into a real, authenticated shell by exec'ing /bin/login (a normal
# "login:"/password prompt); when that shell eventually exits, so does
# this process (login replaced it via exec), and the owning unit's
# Restart=always relaunches the dashboard on the same tty - so the
# console always lands back here. 'r' redraws immediately instead of
# waiting out the refresh interval.
#
# Run with stdin not a tty (piped, redirected, manual invocation, etc.)
# it just prints one plain-text snapshot and exits - useful for a quick
# manual check without taking over a console.
set -uo pipefail

REFRESH_SECS=5

interactive=0
[ -t 0 ] && [ -t 1 ] && interactive=1

use_color=0
if [ "$interactive" = "1" ] && command -v tput >/dev/null 2>&1; then
    ncolors=$(tput colors 2>/dev/null || echo 0)
    [ "${ncolors:-0}" -ge 8 ] 2>/dev/null && use_color=1
fi

if [ "$use_color" = "1" ]; then
    c_bold=$(tput bold); c_reset=$(tput sgr0)
    c_green=$(tput setaf 2); c_red=$(tput setaf 1); c_yellow=$(tput setaf 3)
else
    c_bold=""; c_reset=""; c_green=""; c_red=""; c_yellow=""
fi

# Cursor-home + per-line erase-to-end-of-line + a final
# erase-to-end-of-screen, cached once like the color codes above. Used
# instead of `clear` on every redraw: `clear` erases the whole screen
# before drawing the new frame, so the terminal shows a blank flash
# between frames - the classic cause of a "flickering" status dashboard.
# Moving the cursor home and overwriting the old frame in place instead
# never shows a blank frame - BUT the frame's total line count is not
# actually constant between redraws (an interface gaining/losing its
# address line, a VRF's BGP peers appearing/disappearing, `bootc status`
# wrapping differently, ...), and erasing only *after* the whole new
# frame is a no-op for any row that shrank without the frame as a whole
# getting shorter: a later line lands on top of an unrelated old line
# that happened to be longer, and whatever the new line didn't overwrite
# stays on screen, glued onto it (this actually happened - see the
# comment above cap_el's use below). So every line gets its own
# erase-to-end-of-line right after it's printed, in addition to the
# final erase-to-end-of-screen for when the new frame has fewer *total*
# lines than the old one. cup/el/ed are basic terminfo capabilities
# supported by essentially every terminal a login session could show up
# on (vt100, linux, xterm, ...) - more universal than 8-color support
# even - so none of this is gated behind use_color.
cap_home=""
cap_el=""
cap_eed=""
if [ "$interactive" = "1" ] && command -v tput >/dev/null 2>&1; then
    cap_home=$(tput cup 0 0 2>/dev/null) || cap_home=""
    cap_el=$(tput el 2>/dev/null) || cap_el=""
    cap_eed=$(tput ed 2>/dev/null) || cap_eed=""
fi

# Per-interface throughput is a delta between two samples, not something
# a single `ip`/`/sys` read gives you - these hold the previous sample
# across loop iterations (render() runs in the same long-lived process,
# see the "while true" loop below), so each redraw compares against the
# reading from REFRESH_SECS ago. Empty/zero until the second sample.
declare -A _prev_rx=() _prev_tx=()
_prev_net_ts=0

hr() { printf '%s\n' "--------------------------------------------------------------------------------"; }

# $1: ok|warn|bad -> $2 wrapped in the matching color (or plain, if colors
# aren't available/wanted).
color() {
    case "$1" in
        ok)   printf '%s%s%s' "$c_green" "$2" "$c_reset" ;;
        warn) printf '%s%s%s' "$c_yellow" "$2" "$c_reset" ;;
        bad)  printf '%s%s%s' "$c_red" "$2" "$c_reset" ;;
        *)    printf '%s' "$2" ;;
    esac
}

heading() { printf '%s%s%s\n' "$c_bold" "$1" "$c_reset"; hr; }

fmt_uptime() {
    local secs days hours mins
    secs=$(awk '{print int($1)}' /proc/uptime 2>/dev/null) || secs=0
    days=$((secs / 86400)); hours=$((secs % 86400 / 3600)); mins=$((secs % 3600 / 60))
    printf '%dd %dh %dm' "$days" "$hours" "$mins"
}

# $1: bytes/sec (integer) -> human bit/s (network convention - bits, not
# bytes). Plain "Kbit/s"/"Mbit/s"/"Gbit/s" text, no unicode, to match the
# rest of the dashboard's "works on any serial terminal" rule.
fmt_rate() {
    local bps=${1:-0} bits
    [ "$bps" -lt 0 ] 2>/dev/null && bps=0
    bits=$((bps * 8))
    if [ "$bits" -ge 1000000000 ]; then
        awk -v b="$bits" 'BEGIN{printf "%.1f Gbit/s", b/1000000000}'
    elif [ "$bits" -ge 1000000 ]; then
        awk -v b="$bits" 'BEGIN{printf "%.1f Mbit/s", b/1000000}'
    elif [ "$bits" -ge 1000 ]; then
        awk -v b="$bits" 'BEGIN{printf "%.1f Kbit/s", b/1000}'
    else
        printf '%d bit/s' "$bits"
    fi
}

# One line per systemd unit pair (a periodic sync .service + the .timer
# driving it): FAILED if the service's last run failed, warn if the timer
# itself isn't active (so it'll never run again until that's fixed), ok
# otherwise. This is the main "is this VM actually being kept in sync"
# signal - frr-config-sync/network-config-sync/bootc-image-sync all fail
# silently otherwise (journalctl only, no alerting).
sync_health_line() {
    local svc=$1 timer=$2 label=$3 svc_state timer_state
    svc_state=$(systemctl is-failed "$svc" 2>/dev/null); svc_state=${svc_state:-unknown}
    timer_state=$(systemctl is-active "$timer" 2>/dev/null); timer_state=${timer_state:-unknown}
    if [ "$svc_state" = "failed" ]; then
        printf '  %-24s %s  (see: journalctl -u %s)\n' "$label" "$(color bad "FAILED")" "$svc"
    elif [ "$timer_state" != "active" ]; then
        printf '  %-24s %s  (timer state: %s)\n' "$label" "$(color warn "timer not active")" "$timer_state"
    else
        printf '  %-24s %s\n' "$label" "$(color ok "ok")"
    fi
}

# Established-vs-configured BGP peer count per VRF (one line each) - each
# tenant gets its own VRF and its own BGP instance (see "VRF per Tenant"
# in README), so a single global peer count would hide one tenant's
# session being down behind another's being fine.
#
# Neighbor rows in `show bgp vrf all summary` are identified by column 2
# (the BGP version, always "4"), stable across FRR releases. Which column
# holds "State/PfxRcd" is NOT stable, though - newer FRR appends a
# trailing PfxSnt (and on some versions a Desc) column after it, which
# would make $NF always numeric and every peer look established - so the
# State/PfxRcd column index is read from each VRF section's own
# "Neighbor ..." header line instead of assumed. A peer counts as
# established when that column is numeric (a received-prefix count)
# rather than a state word like Idle/Active/Connect/OpenSent/OpenConfirm.
bgp_vrf_summary() {
    local out
    out=$(vtysh -c 'show bgp vrf all summary' 2>/dev/null) || return 0
    [ -n "$out" ] || return 0
    echo "$out" | awk '
        /^VRF / { vrf=$2; sub(/\(.*/, "", vrf); next }
        /^Default/ { vrf="default"; next }
        /^Neighbor/ {
            state_col = 0
            for (i = 1; i <= NF; i++) {
                if ($i == "State/PfxRcd") { state_col = i; break }
            }
            next
        }
        $2 == "4" {
            if (vrf == "") vrf = "default"
            total[vrf]++
            col = (state_col > 0) ? state_col : NF
            if ($col ~ /^[0-9]+$/) estab[vrf]++
            next
        }
        END {
            for (v in total) print v, estab[v]+0, total[v]
        }
    ' | sort | while read -r vrf estab total; do
        if [ "$estab" -eq "$total" ]; then
            printf '    %-20s %s\n' "$vrf" "$(color ok "$estab/$total established")"
        elif [ "$estab" -eq 0 ]; then
            printf '    %-20s %s\n' "$vrf" "$(color bad "$estab/$total established")"
        else
            printf '    %-20s %s\n' "$vrf" "$(color warn "$estab/$total established")"
        fi
    done
}

render() {
    local frr_state load cpus mem_line disk_line

    heading "frr-bootc - $(hostname) - $(date '+%Y-%m-%d %H:%M:%S %Z')"
    printf '  Uptime: %s\n' "$(fmt_uptime)"
    echo

    heading "System"
    load=$(awk '{print $1, $2, $3}' /proc/loadavg 2>/dev/null) || load="unknown"
    cpus=$(nproc 2>/dev/null || grep -c ^processor /proc/cpuinfo 2>/dev/null || echo "?")
    mem_line=$(free -h 2>/dev/null | awk '/^Mem:/ {printf "%s used / %s total (%s available)", $3, $2, $7}')
    disk_line=$(df -h / 2>/dev/null | awk 'NR==2 {printf "%s used / %s total (%s used)", $3, $2, $5}')
    printf '  Load average (1/5/15m): %s   (%s CPUs)\n' "$load" "$cpus"
    printf '  Memory: %s\n' "${mem_line:-unknown}"
    printf '  Disk (/): %s\n' "${disk_line:-unknown}"
    echo

    heading "Network Interfaces"
    if command -v ip >/dev/null 2>&1; then
        local net_now_ts net_dt net_update=0
        net_now_ts=$EPOCHSECONDS
        net_dt=$((net_now_ts - _prev_net_ts))
        [ "$net_dt" -ge 1 ] && net_update=1
        while IFS= read -r line; do
            local name state addrs state_padded state_disp rx tx rate_str
            name=$(awk '{print $1}' <<<"$line")
            [ "$name" = "lo" ] && continue
            state=$(awk '{print $2}' <<<"$line")
            addrs=$(awk '{$1="";$2="";sub(/^  */,"");print}' <<<"$line")

            # Pad the plain state text to a fixed width *before* coloring
            # it - coloring first and then %-Ns-padding the result would
            # count the invisible ANSI escape bytes against the width and
            # misalign every following column.
            state_padded=$(printf '%-9s' "$state")
            if [ "$state" = "UP" ]; then
                state_disp=$(color ok "$state_padded")
            else
                state_disp=$(color bad "$state_padded")
            fi

            rate_str="throughput: -"
            if [ -f "/sys/class/net/$name/statistics/rx_bytes" ]; then
                rx=$(cat "/sys/class/net/$name/statistics/rx_bytes" 2>/dev/null)
                tx=$(cat "/sys/class/net/$name/statistics/tx_bytes" 2>/dev/null)
                if [ "$net_update" = "1" ] && [ -n "${_prev_rx[$name]:-}" ] && [ -n "$rx" ] && [ -n "$tx" ]; then
                    rate_str="rx $(fmt_rate $(( (rx - _prev_rx[$name]) / net_dt ))) / tx $(fmt_rate $(( (tx - _prev_tx[$name]) / net_dt )))"
                fi
                if [ "$net_update" = "1" ] && [ -n "$rx" ] && [ -n "$tx" ]; then
                    _prev_rx[$name]=$rx
                    _prev_tx[$name]=$tx
                fi
            fi

            printf '  %-16s %s %s\n' "$name" "$state_disp" "$rate_str"
            [ -n "$addrs" ] && printf '  %-16s %s\n' "" "$addrs"
        done < <(ip -brief addr show 2>/dev/null)
        [ "$net_update" = "1" ] && _prev_net_ts=$net_now_ts
    else
        echo "  ip: not available"
    fi
    echo

    heading "FRR"
    frr_state=$(systemctl is-active frr.service 2>/dev/null); frr_state=${frr_state:-unknown}
    if [ "$frr_state" = "active" ]; then
        printf '  frr.service: %s\n' "$(color ok "$frr_state")"
    else
        printf '  frr.service: %s\n' "$(color bad "$frr_state")"
    fi
    if [ "$frr_state" = "active" ] && command -v vtysh >/dev/null 2>&1; then
        local daemons routes bgp_lines
        daemons=$(vtysh -c 'show daemons' 2>/dev/null)
        [ -n "$daemons" ] && printf '  Active daemons: %s\n' "$daemons"
        routes=$(vtysh -c 'show ip route summary' 2>/dev/null | awk '/^Totals/ {print $2 " routes, " $NF " FIB"}')
        [ -n "$routes" ] && printf '  IPv4 RIB: %s\n' "$routes"

        case " $daemons " in
            *" bgpd "*)
                bgp_lines=$(bgp_vrf_summary)
                if [ -n "$bgp_lines" ]; then
                    printf '  BGP peers (per VRF):\n'
                    printf '%s\n' "$bgp_lines"
                fi
                ;;
        esac
    fi
    echo

    heading "Sync Services"
    sync_health_line frr-config-sync.service frr-config-sync.timer "FRR config sync"
    sync_health_line network-config-sync.service network-config-sync.timer "Network config sync"
    sync_health_line bootc-image-sync.service bootc-image-sync.timer "bootc image sync"
    echo

    if command -v bootc >/dev/null 2>&1; then
        heading "System Image (bootc)"
        bootc status 2>/dev/null | sed -n '1,8p' | sed 's/^/  /'
        echo
    fi
}

if [ "$interactive" != "1" ]; then
    render
    exit 0
fi

trap '' INT

# Only the very first draw of this process needs a real `clear`: the
# screen could be showing anything at that point (boot messages, this
# unit's own startup, systemd's own log lines). Every redraw after that
# overwrites this same script's own previous frame in place (see
# cap_home/cap_el/cap_eed above) instead - the whole reason this loop
# stopped using `clear` every cycle.
first_frame=1

while true; do
    frame=$(render; hr; printf 'Refreshing every %ss - [b] log in for a shell   [r] refresh now\n' "$REFRESH_SECS")
    if [ "$first_frame" = "1" ] || [ -z "$cap_home" ] || [ -z "$cap_el" ]; then
        clear
        printf '%s\n' "$frame"
    else
        printf '%s' "$cap_home"
        # Print line by line, erasing to end-of-line after each: the
        # dashboard's own total line count isn't actually constant
        # between redraws (an interface's address line coming and going,
        # a VRF's BGP peers appearing/disappearing, ...), so a later line
        # can land on a row a shorter old frame didn't reach that far
        # down on, or a longer old line at that exact row - either way,
        # without clearing each row individually, whatever the new line
        # doesn't overwrite stays on screen, glued onto it.
        while IFS= read -r frame_line || [ -n "$frame_line" ]; do
            printf '%s%s\n' "$frame_line" "$cap_el"
        done <<<"$frame"
    fi
    [ -n "$cap_eed" ] && printf '%s' "$cap_eed"
    first_frame=0
    key=""
    read -rsn1 -t "$REFRESH_SECS" key || true
    case "$key" in
        b|B)
            clear
            if [ -x /bin/login ]; then
                # exec, not a subshell call: this process (the main PID
                # of frr-console-tty1.service/frr-console-ttyS0.service)
                # IS login now. Once the shell login starts eventually
                # exits, login exits too, systemd sees the unit exit, and
                # Restart=always brings the dashboard straight back on
                # this same tty.
                exec /bin/login
            else
                echo "/bin/login not found - cannot open a shell."
                sleep 2
            fi
            ;;
        *)
            ;;
    esac
done
