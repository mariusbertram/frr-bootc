#!/usr/bin/bash
# Apply network configuration from the mounted "network-config" ConfigMap
# (/run/config/network, a read-only virtiofs mount). Supports two formats,
# which may be mixed:
#   - *.nmconnection   NetworkManager keyfiles, installed as-is
#   - *.yml / *.yaml    nmstate desired-state documents, applied via nmstatectl
# Triggered at boot (after NetworkManager.service) and by
# network-config-sync.path whenever the ConfigMap changes.
set -euo pipefail

SRC=/run/config/network
STATE_DIR=/var/lib/frr-bootc
STAMP="$STATE_DIR/network-config.sha256"
LOCK=/run/network-config-sync.lock

exec {LOCKFD}>"$LOCK"
if ! flock -n "$LOCKFD"; then
    echo "network-config-sync: another run is already in progress, skipping"
    exit 0
fi

mkdir -p "$STATE_DIR"

if [ ! -d "$SRC" ] || [ -z "$(ls -A "$SRC" 2>/dev/null)" ]; then
    echo "network-config-sync: $SRC is empty or not mounted, nothing to sync"
    exit 0
fi

new_sum=$(find "$SRC" -type f -exec sha256sum {} + | sort | sha256sum | awk '{print $1}')
old_sum=$(cat "$STAMP" 2>/dev/null || true)

if [ "$new_sum" = "$old_sum" ]; then
    exit 0
fi

shopt -s nullglob

nmconnections=("$SRC"/*.nmconnection)
if [ "${#nmconnections[@]}" -gt 0 ]; then
    for f in "${nmconnections[@]}"; do
        name=$(basename "$f")
        install -m 600 -o root -g root "$f" "/etc/NetworkManager/system-connections/$name"
        echo "network-config-sync: installed NetworkManager connection $name"
    done
    nmcli connection reload
    for f in "${nmconnections[@]}"; do
        conn_name=$(basename "$f" .nmconnection)
        nmcli connection up "$conn_name" 2>/dev/null \
            || echo "network-config-sync: warning: could not activate connection $conn_name" >&2
    done
fi

statefiles=("$SRC"/*.yml "$SRC"/*.yaml)
for f in "${statefiles[@]}"; do
    echo "network-config-sync: applying nmstate state $(basename "$f")"
    if ! nmstatectl apply "$f"; then
        echo "network-config-sync: failed to apply $(basename "$f")" >&2
        exit 1
    fi
done

echo "$new_sum" > "$STAMP"
