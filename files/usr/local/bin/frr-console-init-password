#!/usr/bin/bash
# Generates and sets a random root password on boot, if root doesn't
# already have a usable one - so console login (the 'b' key in
# frr-console, see console/src/main.rs) works right after a fresh deploy
# without any manual `passwd`/cloud-init step first. Deploys of this VM
# are always fresh instances, not long-lived ones upgraded in place, so
# "first boot" and "every boot of this particular instance" are the same
# thing in practice here - but this only acts when root's password is
# still locked/unset (checked via `passwd -S`, not a "did this already
# run once" marker), which is what actually makes it safe to run on
# every boot: it won't clobber a password an operator set another way
# (cloud-init chpasswd, a manual `passwd` later), and won't regenerate
# (and thus invalidate) an already-generated one on a plain reboot.
#
# The generated password is written to PASSWORD_FILE (root-only
# readable) - frr-console shows it as a banner for as long as that file
# exists; remove it once you've noted the password (or changed it) to
# stop the banner. See the "Console Dashboard" section of README.md.
set -euo pipefail

PASSWORD_FILE=/etc/frr-console-initial-password

log() { echo "frr-console-init-password: $*"; }
err() { echo "frr-console-init-password: ERROR: $*" >&2; }

status=$(passwd -S root 2>/dev/null | awk '{print $2}') || status=""
if [ "$status" = "P" ]; then
    log "root already has a usable password, nothing to do"
    exit 0
fi

# `head -c 20` closing the pipe early after its 20 bytes sends `tr`
# (still reading /dev/urandom) a SIGPIPE, which `set -o pipefail` would
# otherwise report as this whole command substitution failing even
# though it produced exactly the output wanted - a well-known trap for
# any "unbounded generator | head -cN" pipeline. Not a real failure, so
# pipefail is off just for this one line.
set +o pipefail
password=$(tr -dc 'A-HJ-NP-Za-km-z2-9' </dev/urandom | head -c 20)
set -o pipefail
if [ -z "$password" ]; then
    err "failed to generate a password from /dev/urandom"
    exit 1
fi

if ! echo "root:${password}" | chpasswd; then
    err "chpasswd failed - root's password was NOT changed"
    exit 1
fi

(umask 0177 && printf '%s\n' "$password" >"$PASSWORD_FILE")

log "generated an initial root password for console login - see the console dashboard, or $PASSWORD_FILE"
