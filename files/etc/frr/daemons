# Default daemons file baked into the image.
#
# This is only a safe fallback for the very first boot. As soon as the
# "frr-config" ConfigMap is mounted and synced, this file is replaced with
# whatever the ConfigMap contains (see frr-config-sync.service).
zebra=yes
bgpd=no
ospfd=no
ospf6d=no
ripd=no
ripngd=no
isisd=no
pimd=no
pim6d=no
ldpd=no
nhrpd=no
eigrpd=no
babeld=no
sharpd=no
pbrd=no
staticd=yes
bfdd=no
fabricd=no
vrrpd=no
pathd=no
mgmtd=yes

vtysh_enable=yes
zebra_options="   -A 127.0.0.1 -s 90000000"
mgmtd_options="   -A 127.0.0.1"
bgpd_options="    -A 127.0.0.1"
ospfd_options="   -A 127.0.0.1"
ospf6d_options="  -A ::1"
ripd_options="    -A 127.0.0.1"
ripngd_options="  -A ::1"
isisd_options="   -A 127.0.0.1"
pimd_options="    -A 127.0.0.1"
pim6d_options="   -A ::1"
ldpd_options="    -A 127.0.0.1"
nhrpd_options="   -A 127.0.0.1"
eigrpd_options="  -A 127.0.0.1"
babeld_options="  -A 127.0.0.1"
sharpd_options="  -A 127.0.0.1"
pbrd_options="    -A 127.0.0.1"
staticd_options=" -A 127.0.0.1"
bfdd_options="    -A 127.0.0.1"
fabricd_options=" -A 127.0.0.1"
vrrpd_options="   -A 127.0.0.1"
pathd_options="   -A 127.0.0.1"
