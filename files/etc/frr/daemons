# Default daemons file baked into the image.
#
# This is only a safe fallback for the very first boot. As soon as the
# "frr-config" ConfigMap is mounted and synced, this file is replaced with
# whatever the ConfigMap contains (see frr-config-sync.service).
zebra=yes
bgpd=no
ospfd=no
ospf6d=no
ripd=no
ripngd=no
isisd=no
pimd=no
pim6d=no
ldpd=no
nhrpd=no
eigrpd=no
babeld=no
sharpd=no
pbrd=no
staticd=yes
bfdd=no
fabricd=no
vrrpd=no
pathd=no
mgmtd=yes

vtysh_enable=yes
zebra_options="   -A 127.0.0.1 -s 90000000 --limit-fds 100000"
mgmtd_options="   -A 127.0.0.1"
bgpd_options="    -A 127.0.0.1 --limit-fds 100000"
ospfd_options="   -A 127.0.0.1"
ospf6d_options="  -A ::1"
ripd_options="    -A 127.0.0.1"
ripngd_options="  -A ::1"
isisd_options="   -A 127.0.0.1"
pimd_options="    -A 127.0.0.1"
pim6d_options="   -A ::1"
ldpd_options="    -A 127.0.0.1"
nhrpd_options="   -A 127.0.0.1"
eigrpd_options="  -A 127.0.0.1"
babeld_options="  -A 127.0.0.1"
sharpd_options="  -A 127.0.0.1"
pbrd_options="    -A 127.0.0.1"
staticd_options=" -A 127.0.0.1 --limit-fds 100000"
bfdd_options="    -A 127.0.0.1 --limit-fds 100000"
fabricd_options=" -A 127.0.0.1"
vrrpd_options="   -A 127.0.0.1"
pathd_options="   -A 127.0.0.1"

# Read at startup by /etc/init.d/frr-style tooling to set the daemons'
# own ulimit before exec'ing them - matters for bgpd/zebra specifically
# on a router meant to scale to many BGP-coupled tenants (this repo's
# own scaling example is "150", see the README's "A Trunk Instead of
# One NIC per Tenant" section), where each peer/VRF socket eats into the
# default (usually 1024) fd limit.
MAX_FDS=100000
