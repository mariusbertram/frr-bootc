{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cluster.yaml",
  "type": "object",
  "required": ["cluster"],
  "properties": {
    "cluster": {
      "type": "object",
      "required": ["name", "asn_range", "default_image", "default_replicas", "default_resources", "sync_policy"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "asn_range": {
          "type": "object",
          "required": ["min", "max"],
          "properties": {
            "min": {"type": "integer", "minimum": 1},
            "max": {"type": "integer", "minimum": 1}
          }
        },
        "default_image": {"type": "string"},
        "default_replicas": {"type": "integer", "minimum": 1},
        "default_resources": {
          "type": "object",
          "required": ["cores", "memory", "hugepage_size"],
          "properties": {
            "cores": {"type": "integer", "minimum": 1},
            "memory": {"type": "string"},
            "hugepage_size": {"type": "string"}
          }
        },
        "sync_policy": {"type": "string", "enum": ["manual", "automated"]}
      }
    }
  }
}
