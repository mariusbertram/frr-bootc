{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "tenants.yaml",
  "type": "object",
  "required": ["tenants"],
  "properties": {
    "tenants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "vlan_id", "vrf", "local_asn", "peer_asn", "local_ip", "prefix_length", "peer_ip", "advertised_networks"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "vlan_id": {"type": "integer", "minimum": 2, "maximum": 4094},
          "vrf": {"type": "string", "pattern": "^vrf-[a-z0-9-]+$"},
          "route_table_id": {"type": "integer", "minimum": 1000},
          "local_asn": {"type": "integer", "minimum": 1, "maximum": 4294967294},
          "peer_asn": {"type": "integer", "minimum": 1, "maximum": 4294967294},
          "local_ip": {"type": "string"},
          "prefix_length": {"type": "integer", "minimum": 1, "maximum": 32},
          "peer_ip": {"type": "string"},
          "next_hop_address": {"type": "string"},
          "advertised_networks": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "aggregate_networks": {
            "type": "array",
            "items": {"type": "string"}
          },
          "import_prefix_lists": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["seq", "action", "prefix"],
              "properties": {
                "seq": {"type": "integer"},
                "action": {"type": "string", "enum": ["permit", "deny"]},
                "prefix": {"type": "string"},
                "le": {"type": "integer", "minimum": 1, "maximum": 32}
              }
            }
          },
          "export_prefix_lists": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["seq", "action", "prefix"],
              "properties": {
                "seq": {"type": "integer"},
                "action": {"type": "string", "enum": ["permit", "deny"]},
                "prefix": {"type": "string"},
                "le": {"type": "integer", "minimum": 1, "maximum": 32}
              }
            }
          },
          "bfd": {
            "type": "object",
            "required": ["min_rx_ms", "min_tx_ms", "multiplier"],
            "properties": {
              "min_rx_ms": {"type": "integer", "minimum": 50, "maximum": 5000},
              "min_tx_ms": {"type": "integer", "minimum": 50, "maximum": 5000},
              "multiplier": {"type": "integer", "minimum": 2, "maximum": 10}
            }
          },
          "graceful_restart": {"type": "boolean"}
        }
      }
    }
  }
}
