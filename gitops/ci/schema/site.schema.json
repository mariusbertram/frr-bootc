{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "values.yaml",
  "type": "object",
  "required": ["site"],
  "properties": {
    "site": {
      "type": "object",
      "required": ["name", "mac_base", "networks"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "replicas": {"type": "integer", "minimum": 1},
        "image": {"type": "string"},
        "node_selector_value": {"type": "string"},
        "termination_grace_period_seconds": {"type": "integer", "minimum": 0},
        "mac_base": {"type": "string", "pattern": "^([0-9a-fA-F]{2}:){4}[0-9a-fA-F]{2}$"},
        "resources": {
          "type": "object",
          "properties": {
            "cores": {"type": "integer", "minimum": 1},
            "memory": {"type": "string"},
            "hugepage_size": {"type": "string"}
          }
        },
        "networks": {
          "type": "object",
          "required": ["lan"],
          "properties": {
            "lan": {
              "type": "object",
              "required": ["ip", "prefix_length", "next_hop_address"],
              "properties": {
                "ip": {"type": "string"},
                "prefix_length": {"type": "integer", "minimum": 1, "maximum": 32},
                "next_hop_address": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
