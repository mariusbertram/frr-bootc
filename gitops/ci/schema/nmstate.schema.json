{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "generated nmstate.yml (subset actually used by this repo)",
  "type": "object",
  "required": ["interfaces"],
  "properties": {
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "state"],
        "properties": {
          "name": {"type": "string"},
          "type": {"type": "string", "enum": ["ethernet", "vlan", "vrf"]},
          "state": {"type": "string", "enum": ["up", "down"]},
          "vlan": {
            "type": "object",
            "required": ["base-iface", "id"],
            "properties": {
              "base-iface": {"type": "string"},
              "id": {"type": "integer", "minimum": 1, "maximum": 4094}
            }
          },
          "vrf": {
            "type": "object",
            "required": ["port", "route-table-id"],
            "properties": {
              "port": {"type": "array", "items": {"type": "string"}},
              "route-table-id": {"type": "integer"}
            }
          },
          "ipv4": {
            "type": "object",
            "properties": {
              "enabled": {"type": "boolean"},
              "address": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["ip", "prefix-length"],
                  "properties": {
                    "ip": {"type": "string"},
                    "prefix-length": {"type": "integer", "minimum": 1, "maximum": 32}
                  }
                }
              }
            }
          }
        }
      }
    },
    "routes": {
      "type": "object",
      "properties": {
        "config": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["destination", "next-hop-interface", "table-id"],
            "properties": {
              "destination": {"type": "string"},
              "next-hop-address": {"type": "string"},
              "next-hop-interface": {"type": "string"},
              "table-id": {"type": "integer"}
            }
          }
        }
      }
    },
    "route-rules": {
      "type": "object",
      "properties": {
        "config": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ip-from", "priority", "route-table"],
            "properties": {
              "ip-from": {"type": "string"},
              "priority": {"type": "integer"},
              "route-table": {"type": "integer"}
            }
          }
        }
      }
    }
  }
}
